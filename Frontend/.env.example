# Set to the Render API service origin for production. Leave blank locally to use the Vite /api proxy.
# Example: https://your-api.onrender.com
VITE_API_BASE_URL=

# Public frontend origin used for production Supabase Auth email redirects.
# Set this to the deployed Cloudflare Pages origin; leave blank locally.
VITE_APP_URL=https://jacdash.pages.dev
